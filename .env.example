# ============================================================
# smart-search-skill — Environment Configuration
# Copy to .env and fill in your values: cp .env.example .env
# NEVER commit .env to git
# ============================================================

# LLM — Required for AI-powered result evaluation
OPENAI_API_KEY=sk-...

# SearXNG — Required when running via Docker
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SEARXNG_SECRET=your-random-secret-here

# SearXNG URL (default: http://localhost:9090)
SEARXNG_URL=http://localhost:9090

# Optional tuning
MAX_SEARCH_RESULTS_TOOL=10
MAX_SEARCH_RESULTS_EVALUATOR=5
DEBUG=false
LOG_LEVEL=INFO
