FROM python:3.11-slim AS builder

WORKDIR /app

RUN apt-get update -qq \
 && apt-get install -y --no-install-recommends build-essential \
 && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir --root-user-action=ignore --prefix=/install '.[mcp]'

FROM python:3.11-slim AS runtime

WORKDIR /app

RUN apt-get update -qq \
 && apt-get install -y --no-install-recommends dumb-init curl \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd -g 1100 mcp \
 && useradd -m -u 1100 -g mcp -s /bin/bash mcp

COPY --from=builder /install /usr/local

ENV HOME=/tmp \
    PYTHONUNBUFFERED=1

USER mcp

EXPOSE 8002

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD curl -fsS http://127.0.0.1:8002/health >/dev/null || exit 1

CMD ["dumb-init", "--", "uvicorn", "search_workflow.mcp_server:app", "--host", "0.0.0.0", "--port", "8002"]
