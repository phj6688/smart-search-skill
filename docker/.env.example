# docker/.env.example
# SearXNG Configuration
SEARXNG_SECRET=your_super_secret_key_here_change_this_in_production
COMPOSE_PROJECT_NAME=search-workflow

# SearXNG Version (pin for stability)
SEARXNG_VERSION=2025.5.18

# Performance Settings
UWSGI_WORKERS=4
UWSGI_THREADS=4

# Redis Configuration (optional password)
REDIS_PASSWORD=

# Development/Production Mode
ENVIRONMENT=development
DEBUG=false
