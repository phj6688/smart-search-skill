
# LLM Configuration
# Required for AI-powered result evaluation
OPENAI_API_KEY=sk-...
# SearXNG Configuration
# Copy this to docker/.env and fill in values
# NEVER commit docker/.env to git

# Required: random secret key for SearXNG session signing
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SEARXNG_SECRET=your-random-secret-here-generate-a-new-one

# Optional overrides
# SEARXNG_PORT=9090
# SEARXNG_BASE_URL=http://localhost:9090/
